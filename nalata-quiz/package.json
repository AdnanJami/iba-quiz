{
  "name": "nalata-quiz",
  "version": "1.0.0",
  "description": "Na Lata - a simple, minimalist exam/quiz web app with SQLite-backed question templates, timed attempts, and browser-cached results.",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "seed": "tsx src/seed.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "postinstall": "npm run seed"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
